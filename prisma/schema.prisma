generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  administrator
  service_leader
  volunteer
}

enum EventType {
  single
  recurring
}

enum OnboardingState {
  REGISTERED
  PROFILE_COMPLETE
  FULLY_ONBOARDED
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
}

enum ReplacementStatus {
  PENDING
  APPROVED
  DECLINED
}

enum TeamRequestKind {
  SIGNUP
  TEAM_JOIN
}

enum TeamRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum AssignmentStatus {
  open
  assigned
  confirmed
  declined
}

enum NotificationChannel {
  in_app
  email
  websocket
  webhook
}

enum BackgroundJobKind {
  resource_upload
  resource_download
  notification_dispatch
  ai_task
  scheduling_preview
}

enum BackgroundJobStatus {
  queued
  running
  completed
  failed
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  fullName        String
  role            Role            @default(volunteer)
  onboardingState OnboardingState @default(REGISTERED)
  suspendedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  settings               UserSettings?
  sessions               Session[]
  tokens                 UserToken[]
  availabilities         Availability[]
  replacementRequests    Replacement[]       @relation("ReplacementRequester")
  teamJoinRequests       TeamAccessRequest[] @relation("TeamRequestTarget")
  submittedTeamRequests  TeamAccessRequest[] @relation("TeamRequestRequester")
  reviewedTeamRequests   TeamAccessRequest[] @relation("TeamRequestReviewer")
  createdFromRequests    TeamAccessRequest[] @relation("TeamRequestCreatedUser")
  replacementsAsAssignee Replacement[]       @relation("ReplacementAssignee")

  memberships     TeamMembership[]
  leadingTeams    Team[]           @relation("TeamLeader")
  assignments     Assignment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  backgroundJobs  BackgroundJob[]
  schedulingPlans SchedulingPlan[]

  meetingGroupsLed    MeetingGroup[]       @relation("MeetingGroupLeader")
  meetingGroupMembers MeetingGroupMember[]
  meetingsCreated     Meeting[]            @relation("MeetingCreatedUser")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  language                String  @default("en")
  theme                   String  @default("system")
  phone                   String?
  address                 String?
  emergencyName           String?
  emergencyPhone          String?
  preferredShifts         Json?
  preferredTeamIds        Json?
  preferredDutyIds        Json?
  preferredLocationValues Json?
  competencies            Json?
  serviceNotes            String?
  dashboardLayout         Json?
  aiAutoSchedule          Boolean @default(false)
  aiEnabled               Boolean @default(true)
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamGroup {
  id          String   @id @default(cuid())
  name        String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teams       Team[]
  meetingGroups MeetingGroup[]
}

model Team {
  id                   String              @id @default(cuid())
  name                 String              @unique
  description          String?
  color                String?
  icon                 String?
  requiredCompetencies Json?
  leaderId             String?
  groupId              String?
  leader               User?               @relation("TeamLeader", fields: [leaderId], references: [id])
  group                TeamGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  memberships          TeamMembership[]
  inventory            InventoryItem[]
  resources            ResourceFile[]
  slots                EventSlot[]
  meetings             Meeting[]
  duties               Duty[]
  accessRequests       TeamAccessRequest[]
  availabilities       Availability[]
  backgroundJobs       BackgroundJob[]
}

model TeamMembership {
  id        String               @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime             @default(now())
  team      Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  duties    TeamMembershipDuty[]

  @@unique([teamId, userId])
}

model TeamMembershipDuty {
  id           String         @id @default(cuid())
  membershipId String
  dutyId       String
  createdAt    DateTime       @default(now())
  membership   TeamMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  duty         Duty           @relation(fields: [dutyId], references: [id], onDelete: Cascade)

  @@unique([membershipId, dutyId])
}

model Event {
  id                       String    @id @default(cuid())
  title                    String
  description              String?
  type                     EventType
  color                    String?
  icon                     String?
  locationValue            String?
  startsAt                 DateTime
  endsAt                   DateTime
  recurrenceRule           String?
  recurrenceTz             String?
  recurrenceUntil          DateTime?
  recurrenceDurationMonths Int?
  recurrenceAutoRenew      Boolean   @default(true)
  recurrenceRenewMonths    Int?
  parentEventId            String?
  historicalSnapshot       Json?
  createdById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  parentEvent Event?  @relation("RecurringEventInstances", fields: [parentEventId], references: [id], onDelete: SetNull)
  instances   Event[] @relation("RecurringEventInstances")

  slots EventSlot[]
}

model Duty {
  id                   String   @id @default(cuid())
  teamId               String
  name                 String
  description          String?
  color                String?
  icon                 String?
  requiredCompetencies Json?
  recommendedEventVolunteers Int @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  team        Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slots       EventSlot[]
  memberships TeamMembershipDuty[]
}

model EventSlot {
  id                 String   @id @default(cuid())
  eventId            String
  teamId             String
  dutyId             String
  startsAt           DateTime
  endsAt             DateTime
  required           Boolean  @default(true)
  requiredVolunteers Int      @default(1)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  duty        Duty         @relation(fields: [dutyId], references: [id], onDelete: Restrict)
  assignments Assignment[]
}

model Assignment {
  id           String           @id @default(cuid())
  slotId       String
  assigneeId   String?
  status       AssignmentStatus @default(open)
  autoAssigned Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  slot         EventSlot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  assignee     User?            @relation(fields: [assigneeId], references: [id])
  replacements Replacement[]
}

model InventoryItem {
  id               String    @id @default(cuid())
  teamId           String
  name             String
  serialNumber     String?
  status           String
  maintenanceDueAt DateTime?
  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model ResourceFile {
  id         String   @id @default(cuid())
  teamId     String?
  name       String
  path       String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

model AiSetting {
  id                              String   @id @default("global")
  provider                        String   @default("disabled")
  apiKey                          String?
  ollamaUrl                       String?
  model                           String?
  smtpHost                        String?
  smtpPort                        Int      @default(587)
  smtpSecure                      Boolean  @default(false)
  smtpUser                        String?
  smtpPassword                    String?
  smtpFromEmail                   String?
  smtpFromName                    String?
  smtpReplyTo                     String?
  redisUrl                        String?
  webAppUrl                       String?
  resourceStorageDriver           String?  @default("local")
  totalStorageLimitBytes          Int?
  defaultTeamStorageLimitBytes    Int?
  resourceTeamQuotaRules          Json?
  resourceS3Endpoint              String?
  resourceS3Region                String?
  resourceS3Bucket                String?
  resourceS3AccessKey             String?
  resourceS3SecretKey             String?
  resourceS3ForcePathStyle        Boolean  @default(true)
  resourceS3UseSsl                Boolean  @default(false)
  resourceJobConcurrency          Int      @default(3)
  notificationJobConcurrency      Int      @default(5)
  aiJobConcurrency                Int      @default(2)
  schedulingPreviewTransport      String   @default("hybrid")
  schedulingPreviewRetryCount     Int      @default(20)
  schedulingPreviewPollIntervalMs Int      @default(4000)
  schedulingAsyncRangeDays        Int      @default(14)
  schedulingAsyncManualSelections Int      @default(20)
  schedulingAsyncWithoutEvent     Boolean  @default(true)
  inAppNotificationsEnabled       Boolean  @default(true)
  websocketNotificationsEnabled   Boolean  @default(true)
  emailNotificationsEnabled       Boolean  @default(true)
  webhookEnabled                  Boolean  @default(false)
  webhookUrl                      String?
  webhookSecret                   String?
  agnostic                        Boolean  @default(false)
  automationMode                  String   @default("balanced")
  remindersEnabled                Boolean  @default(true)
  quietHours                      Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model Notification {
  id         String                 @id @default(cuid())
  userId     String
  channel    NotificationChannel
  subject    String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime               @default(now())
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(queued)
  target         String?
  payload        Json?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

model BackgroundJob {
  id          String              @id @default(cuid())
  kind        BackgroundJobKind
  status      BackgroundJobStatus @default(queued)
  progress    Int                 @default(0)
  userId      String?
  teamId      String?
  entityType  String?
  entityId    String?
  payload     Json?
  result      Json?
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SchedulingPlan {
  id                 String    @id @default(cuid())
  actorId            String?
  anchorEventId      String
  anchorEventTitle   String
  from               DateTime
  to                 DateTime
  scope              String
  applyScope         String?
  criteria           Json?
  summary            Json?
  manualSelections   Json?
  invalidatedAt      DateTime?
  invalidationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  actor User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  items SchedulingPlanItem[]
}

model SchedulingPlanItem {
  id                   String    @id @default(cuid())
  planId               String
  slotId               String
  slotDemandKey        String
  slotDemandIndex      Int       @default(1)
  eventId              String
  eventTitle           String
  teamId               String
  teamName             String
  dutyId               String
  roleName             String
  startsAt             DateTime
  endsAt               DateTime
  coverageStatus       String
  strategy             String
  assigneeId           String?
  assigneeName         String?
  score                Int?
  reasons              Json?
  candidates           Json?
  cycleKey             String
  cycleIndex           Int
  cycleLength          Int
  cycleNumber          Int
  selectionSource      String
  existingAssignmentId String?
  existingAssigneeId   String?
  existingAssigneeName String?
  appliedAt            DateTime?
  appliedScope         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  plan SchedulingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([teamId, dutyId, startsAt])
  @@index([eventId, startsAt])
}

model UserPreferenceCatalogItem {
  id          String   @id @default(cuid())
  type        String
  value       String
  label       String
  description String?
  keywords    Json?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([type, value])
  @@index([type, active, sortOrder])
}

model HolidayCalendarDay {
  id              String   @id @default(cuid())
  date            DateTime @unique
  countryCode     String   @default("IT")
  localName       String
  name            String
  isPublicHoliday Boolean  @default(true)
  source          String   @default("nager")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([countryCode, date])
}

model Availability {
  id        String           @id @default(cuid())
  userId    String
  teamId    String?
  type      AvailabilityType
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

model Replacement {
  id                    String            @id @default(cuid())
  assignmentId          String
  requestedByUserId     String
  replacementAssigneeId String?
  status                ReplacementStatus @default(PENDING)
  reason                String?
  createdAt             DateTime          @default(now())
  resolvedAt            DateTime?

  assignment          Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  requestedBy         User       @relation("ReplacementRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  replacementAssignee User?      @relation("ReplacementAssignee", fields: [replacementAssigneeId], references: [id], onDelete: SetNull)
}

model TeamAccessRequest {
  id                String            @id @default(cuid())
  teamId            String
  kind              TeamRequestKind
  status            TeamRequestStatus @default(PENDING)
  fullName          String?
  email             String?
  passwordHash      String?
  targetUserId      String?
  requestedByUserId String?
  reviewedByUserId  String?
  createdUserId     String?
  createdAt         DateTime          @default(now())
  reviewedAt        DateTime?

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  targetUser  User? @relation("TeamRequestTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  requestedBy User? @relation("TeamRequestRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy  User? @relation("TeamRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdUser User? @relation("TeamRequestCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([email, status])
}

model MeetingGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  leaderId    String?
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leader   User?                @relation("MeetingGroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  group    TeamGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  members  MeetingGroupMember[]
  meetings Meeting[]
}

model MeetingGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group MeetingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Meeting {
  id                       String    @id @default(cuid())
  meetingGroupId           String?
  teamId                   String?
  title                    String
  description              String?
  locationValue            String?
  startsAt                 DateTime
  endsAt                   DateTime
  type                     EventType
  recurrenceRule           String?
  recurrenceTz             String?
  recurrenceUntil          DateTime?
  recurrenceDurationMonths Int?
  recurrenceAutoRenew      Boolean   @default(true)
  recurrenceRenewMonths    Int?
  parentMeetingId          String?
  historicalSnapshot       Json?
  createdById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  meetingGroup  MeetingGroup? @relation(fields: [meetingGroupId], references: [id], onDelete: Cascade)
  team          Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parentMeeting Meeting?      @relation("RecurringMeetingInstances", fields: [parentMeetingId], references: [id], onDelete: Cascade)
  instances     Meeting[]     @relation("RecurringMeetingInstances")
  createdByUser User?         @relation("MeetingCreatedUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([meetingGroupId])
  @@index([teamId])
  @@index([startsAt])
}
