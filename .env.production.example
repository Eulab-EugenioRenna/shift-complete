NODE_ENV=production
PORT=3333
WEB_PORT=4200
WEB_HOST_PORT=8080

POSTGRES_DB=shift_complete
POSTGRES_USER=shift
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql://shift:change-this-postgres-password@localhost:5432/shift_complete?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-with-a-long-random-secret
RUN_MIGRATIONS_ON_BOOT=true
RUN_SEED_ON_BOOT=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
ADMIN_NAME=Amministratore

AI_PROVIDER=disabled
AI_MODEL=
OLLAMA_URL=http://localhost:11434

WEB_APP_URL=https://your-domain.example

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_FROM_NAME=Shift Complete
SMTP_REPLY_TO=

RESOURCE_STORAGE_DRIVER=s3
RESOURCE_STORAGE_PATH=storage/resources
RESOURCE_TEMP_PATH=storage/resources/tmp
RESOURCE_S3_ENDPOINT=http://localhost:9000
RESOURCE_S3_REGION=us-east-1
RESOURCE_S3_BUCKET=shift-complete-resources
RESOURCE_S3_ACCESS_KEY=shiftminio
RESOURCE_S3_SECRET_KEY=change-this-minio-secret
RESOURCE_S3_FORCE_PATH_STYLE=true
RESOURCE_S3_USE_SSL=false

RESOURCE_JOB_CONCURRENCY=3
NOTIFICATION_JOB_CONCURRENCY=5
AI_JOB_CONCURRENCY=2

IN_APP_NOTIFICATIONS_ENABLED=true
WEBSOCKET_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
WEBHOOK_NOTIFICATIONS_ENABLED=false
WEBHOOK_NOTIFICATIONS_URL=
WEBHOOK_NOTIFICATIONS_SECRET=
