{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shift-complete/shared-types": ["libs/shared-types/src/index.ts"],
      "@shift-complete/ui-kit": ["libs/ui-kit/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
